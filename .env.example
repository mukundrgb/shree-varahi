# Copy this file to .env.local.
# URL of the Shree Varahi backend (shree-varahi-be), including the API version.
# Market data (CMOTS) is fetched by the backend; the CMOTS token never goes to the frontend.
NEXT_PUBLIC_API_URL=http://localhost:9001/api/v1

# Server-side calls to the backend (content pages, site config). On the same server as the backend
# this can be http://127.0.0.1:9001/api/v1. Defaults to NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:9001/api/v1
# Sent as x-internal-key on server-side calls (higher rate limits). Same value as the backend.
# INTERNAL_API_KEY=
# The backend calls /api/revalidate with this secret after a publish. Same value as the
# backend's WEBSITE_REVALIDATE_SECRET. Without it, pages refresh only every hour.
# REVALIDATE_SECRET=
# Public address of the site (canonical links, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
